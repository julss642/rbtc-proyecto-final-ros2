<?xml version="1.0"?>
<package format="3">
  <name>rbtc_mission_manager</name>
  <version>0.1.0</version>
  <description>Servicio ROS 2 que ejecuta una misión de waypoints YAML con Nav2 Simple Commander.</description>
  <maintainer email="julss642@users.noreply.github.com">Juliana Solorza</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
